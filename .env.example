NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://nightstream:change_me@localhost:5432/nightstream
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2147483648

# Configure real outbound email before production. In development, the verification URL is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NightStream <no-reply@example.com>

# Integrate a real age-assurance provider before launch. Never enable the bypass in production.
AGE_ASSURANCE_WEBHOOK_SECRET=replace-with-an-independent-random-secret
AGE_ASSURANCE_DEV_BYPASS=false

# Optional list of emails that should receive moderator role after registering.
# Prefer `npm run promote-moderator -- person@example.com` for explicit role assignment.
